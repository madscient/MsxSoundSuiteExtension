<?xml version="1.0" ?>
<!DOCTYPE msxconfig SYSTEM 'msxconfig2.dtd'>
<msxconfig>
  <info>
    <name>Y8960 Cartridge (MSX Sound Suite @VERSION@)</name>
    <manufacturer>HRA!</manufacturer>
    <code/>
    <release_year>2026</release_year>
    <description>MSX2++ equivalent sound cartridge, with MSX Sound Suite @VERSION@ in its ROM.</description>
    <type>sound expansion</type>
  </info>
  <devices>
    <primary slot="any">
      <secondary slot="any">
        <ROM id="Y8960">
          <mem base="0x4000" size="0x8000"/>
          <!-- The volume of the OPM, the loudest of the sound chips. The
               others follow at the levels measured on the cartridge. -->
          <sound>
            <volume>30000</volume>
          </sound>
          <mappertype>Y8960Cartridge</mappertype>
          <rom>
            <sha1>@SHA1@</sha1>
            <filename>@FILENAME@</filename>
          </rom>
        </ROM>
      </secondary>
    </primary>
  </devices>
</msxconfig>
